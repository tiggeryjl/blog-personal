<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.blog.mapper.DailyMapper">

    <!-- 分页查询逻辑删除的日常（回收站） -->
    <select id="recyclePageQuery" resultType="com.blog.pojo.entity.Daily">
        SELECT *
        FROM daily
        <where>
            delete_flag = 1
            <if test="content != null and content != ''">
                AND content LIKE CONCAT('%', #{content}, '%')
            </if>
            <if test="type != null">
                AND type = #{type}
            </if>
            <if test="isTop != null">
                AND is_top = #{isTop}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="begin != null">
                AND create_time &gt;= #{begin}
            </if>
            <if test="end != null">
                AND create_time &lt;= #{end}
            </if>
        </where>
        ORDER BY update_time DESC, create_time DESC
    </select>

    <!-- 批量恢复（逻辑删除 -> 正常） -->
    <update id="recoverBatch">
        UPDATE daily
        SET delete_flag = 0, update_time = NOW()
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 批量逻辑删除 -->
    <update id="logicDelete">
        UPDATE daily
        SET delete_flag = 1, update_time = NOW()
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 批量彻底删除 -->
    <delete id="deleteBatch">
        DELETE FROM daily
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
