<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.blog.mapper.TagMapper">

    <insert id="add">
        INSERT INTO tag(name,status,delete_flag,create_time,update_time)
        VALUES (#{name},#{status},#{deleteFlag},#{createTime},#{updateTime})
    </insert>

    <update id="update">
        UPDATE tag
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="status != null ">status = #{status},</if>
            <if test="deleteFlag != null">delete_flag = #{deleteFlag},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 批量逻辑删除 -->
    <update id="logicDelete">
        UPDATE tag SET delete_flag = 1, update_time = NOW()
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 分页查询逻辑删除的标签（回收站） -->
    <select id="recyclePageQuery" resultType="com.blog.pojo.vo.TagVo">
        SELECT *
        FROM tag
        <where>
            delete_flag = 1
            <if test="keyword != null and keyword != ''">
                AND name LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY update_time DESC, create_time DESC
    </select>

    <!-- 批量恢复（逻辑删除 -> 正常） -->
    <update id="recover">
        UPDATE tag SET delete_flag = 0, update_time = NOW()
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 批量彻底删除 -->
    <delete id="deleteBatch">
        DELETE FROM tag
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="getTagOptions" resultType="com.blog.pojo.vo.OptionVO">
        SELECT
            name AS label,
            id AS value
        FROM tag
        WHERE status = 1 AND delete_flag = 0
        ORDER BY create_time DESC
    </select>

</mapper>
